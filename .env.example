# Copy to .env and adjust. .env is gitignored.

ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=sqlite:///./claims.db
UPLOAD_DIR=./data/uploads

# Keep MOCK_LLM=true until a real key is available; the service then uses a
# deterministic fake extractor so the pipeline is fully runnable offline.
MOCK_LLM=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-opus-5
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=60

# Below this many extracted characters a PDF page is treated as image-only.
TEXT_LAYER_MIN_CHARS=100
