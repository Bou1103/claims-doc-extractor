ENVIRONMENT=local
LOG_LEVEL=INFO
LOG_JSON=true

DATABASE_URL=sqlite:///./claims.db
UPLOAD_DIR=./data/uploads

MOCK_LLM=true
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5
LLM_MAX_ATTEMPTS=3
LLM_TIMEOUT_SECONDS=60

# Below this many extracted characters a PDF page is treated as image-only.
TEXT_LAYER_MIN_CHARS=100
